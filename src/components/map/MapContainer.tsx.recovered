        </div>

        {/* ?€ë©”ë‰´ ?„ì´ì½?ë¦¬ìŠ¤?????¬ìš© ë¹ˆë„ ??ë°°ì¹˜ */}
        <div className="flex flex-col gap-5 w-full items-center">
          {[
            { id: 'home' as TabType,      label: '??,      icon: Home,          desc: 'ì§€?„ì—??ë§›ì§‘ ?ìƒ‰' },
            { id: 'near' as TabType,      label: 'ì£¼ë?ë§›ì§‘', icon: NearbyIcon,    desc: '??ì£¼ë? ?«í”Œ ?ìƒ‰' },
            { id: 'favorites' as TabType, label: '?€??,    icon: Star,          desc: '?€?¥í•œ ë§›ì§‘ ëª¨ìŒ' },
            { id: 'planning' as TabType,  label: '?¼ì •',    icon: CalendarRange,  desc: '?¬í–‰ ì½”ìŠ¤ ë§Œë“¤ê¸? },
            { id: 'shopping' as TabType,  label: '?¼í•‘',    icon: ShoppingBag,   desc: 'ë°€?¤íŠ¸ ?¼í•‘?˜ê¸°' },
            { id: 'mypage' as TabType,    label: 'ë§ˆì´',    icon: User,          desc: '?„ë¡œ??& ?œë¹„???•ë³´' },
