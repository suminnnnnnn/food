const getFormattedCategory = (categoryStr?: string | null) => {
  if (!categoryStr) return '';
  const parts = categoryStr.split('>');
  if (parts.length >= 2) {
    const main = parts[0].trim();
    const sub = parts[parts.length - 1].trim();
    return `${main} ??${sub}`;
  }
  return categoryStr.trim();
};

const checkAvailability = (value: string | null | undefined): boolean => {
  if (!value || value === 'Á¤º¸ ¾øÀ½' || value.trim() === '') return false;
  const cleanVal = value.trim();
  const temp = cleanVal
    .replace(/ºÒ°¡´É/g, '')
    .replace(/ºÒ°¡/g, '')
    .replace(/¾øÀ½/g, '')
    .replace(/¹ÌÁö¿ø/g, '')
    .replace(/¹ÌÁ¦°ø/g, '')
    .replace(/±İÁö/g, '');
  const hasPositiveException = /°¡´É|Áö¿ø|Á¦°ø|ÀÌ¿ë/.test(temp);
  const hasNegation = /ºÒ°¡|¾øÀ½|ºÒ°¡´É|±İÁö|¹ÌÁö¿ø|¹ÌÁ¦°ø/.test(cleanVal);
  if (hasNegation && !hasPositiveException) {
    return false;
  }
  return true;
};

const getRestaurantAllTags = (r: Restaurant): string[] => {
  const tags: string[] = [];
  const contentTags = r.content_tags?.filter(
    tag => tag.label !== '? íŠœë¸??«í”Œ' && tag.label !== '? íŠœë¸Œí•«??
  ) || [];
  if (contentTags.length > 0) {
    contentTags.forEach(t => {
      if (t.source === 'michelin' || t.label.includes('ë¯¸ì‰ë¦?)) tags.push('ë¯¸ì‰ë¦?);
      if (t.source === 'blueribbon' || t.label.includes('ë¸”ë£¨ë¦¬ë³¸')) tags.push('ë¸”ë£¨ë¦¬ë³¸');
      if (t.source === 'ddoganjib' || t.label.includes('?ê°„ì§?)) tags.push('?ê°„ì§?);
    });
  } else {
    const seed = r.name.charCodeAt(0) || 0;
    if (seed % 3 === 0) {
      tags.push('ë¯¸ì‰ë¦?, 'ë¸”ë£¨ë¦¬ë³¸');
    } else if (seed % 3 === 1) {
      tags.push('ë¸”ë£¨ë¦¬ë³¸', '?ê°„ì§?);
    } else {
      tags.push('ë¯¸ì‰ë¦?, '?ê°„ì§?);
    }
  }
  if (r.parking && r.parking !== '?•ë³´ ?†ìŒ' && checkAvailability(r.parking)) {
    tags.push('ì£¼ì°¨ê°€??);
  }
  if (r.reservation && r.reservation !== '?•ë³´ ?†ìŒ' && checkAvailability(r.reservation)) {
    tags.push('?ˆì•½ê°€??);
  }
  if (r.packaging && r.packaging !== '?•ë³´ ?†ìŒ' && checkAvailability(r.packaging)) {
    tags.push('?¬ì¥ê°€??);
  }

  // ë¹„ë””???¤ì›Œ?œë? ì¶”ì¶œ?˜ì—¬ ?œê·¸ ëª©ë¡???¬í•¨
  if (r.videos && r.videos.length > 0) {
    r.videos.forEach(v => {
      if (v.keywords && v.keywords.length > 0) {
        v.keywords.forEach(kw => {
          if (!tags.includes(kw)) {
            tags.push(kw);
          }
        });
      }
    });
  }

  return tags;
};

