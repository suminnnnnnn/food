              <div className="flex gap-1.5 flex-wrap">
                {['ë§›ì§‘ ?ë°©', '?¬ìœ ë¡œìš´ ?ë§', 'ë°”ìœ ëª…ì†Œ ê´€ê´?].map(item => (
