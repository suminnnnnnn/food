  const [nearRouteRestaurants, setNearRouteRestaurants] = useState<Restaurant[]>([]);

  // ? ê·œ ?¼ì • ?˜ë¦½ ? ì§œ/?œëª© ?¤ì • ???íƒœ
  const [showInitPlanningModal, setShowInitPlanningModal] = useState<boolean>(false);
